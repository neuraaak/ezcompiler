{
    "_comment": "EXAMPLE JSON CONFIG - Nuitka, console app, auto settings",
    "_scenario": "Application compilée avec Nuitka - optimisations maximales, zip + disk upload",
    "version": "3.0.0",
    "project_name": "ExampleApp-Optimized",
    "project_description": "Sample application compiled with Nuitka for maximum performance",
    "company_name": "EzCompiler Inc.",
    "author": "Nuitka Enthusiast",
    "main_file": "main.py",
    "output_folder": "dist/nuitka_build",
    "icon": "",
    "include_files": {
        "files": [
            "main.py"
        ],
        "folders": [
            "assets",
            "config"
        ]
    },
    "packages": [
        "json",
        "os",
        "platform",
        "sys"
    ],
    "includes": [
        "datetime",
        "pathlib"
    ],
    "excludes": [
        "tkinter",
        "unittest",
        "test",
        "email",
        "xml",
        "http"
    ],
    "compilation": {
        "compiler": "Nuitka",
        "console": true,
        "zip_needed": true,
        "repo_needed": true
    },
    "upload": {
        "structure": "disk",
        "repo_path": "releases/optimized",
        "server_url": ""
    },
    "advanced": {
        "optimize": true,
        "strip": true,
        "debug": false
    }
}