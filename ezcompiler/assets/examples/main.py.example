# ///////////////////////////////////////////////////////////////
# EXAMPLE PROJECT - Sample application for EzCompiler testing
# ///////////////////////////////////////////////////////////////

"""
Sample Python application for testing EzCompiler compilation.

This file serves as an example main entry point that can be compiled
using EzCompiler with any supported backend (Cx_Freeze, PyInstaller, Nuitka).
"""

from __future__ import annotations

# ///////////////////////////////////////////////////////////////
# IMPORTS
# ///////////////////////////////////////////////////////////////
# Standard library imports
import json
import os
import platform
import sys
from datetime import datetime
from pathlib import Path

# ///////////////////////////////////////////////////////////////
# CONSTANTS
# ///////////////////////////////////////////////////////////////

APP_NAME = "ExampleApp"
APP_VERSION = "1.0.0"
APP_AUTHOR = "EzCompiler"

# Resolve application path (works for both frozen and unfrozen)
APP_PATH = (
    Path(sys._MEIPASS)
    if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS")
    else Path(__file__).parent
)

# ///////////////////////////////////////////////////////////////
# FUNCTIONS
# ///////////////////////////////////////////////////////////////


def get_system_info() -> dict[str, str]:
    """Collect basic system information."""
    return {
        "platform": platform.system(),
        "platform_version": platform.version(),
        "architecture": platform.machine(),
        "python_version": platform.python_version(),
        "executable": sys.executable,
        "frozen": str(getattr(sys, "frozen", False)),
        "app_path": str(APP_PATH),
        "cwd": os.getcwd(),
    }


def print_header() -> None:
    """Print application header."""
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print("=" * 50)
    print(f"  {APP_NAME} v{APP_VERSION}")
    print(f"  Author: {APP_AUTHOR}")
    print(f"  Date: {now}")
    print("=" * 50)


def print_system_info() -> None:
    """Print system information."""
    info = get_system_info()
    print("\n[System Information]")
    for key, value in info.items():
        print(f"  {key}: {value}")


def print_paths() -> None:
    """Print relevant paths."""
    print("\n[Paths]")
    print(f"  Application: {APP_PATH}")
    print(f"  Working dir: {Path.cwd()}")
    print(f"  Script:      {__file__}")


def export_info(output_path: Path | None = None) -> None:
    """Export system info as JSON file."""
    info = {
        "app": {
            "name": APP_NAME,
            "version": APP_VERSION,
            "author": APP_AUTHOR,
        },
        "system": get_system_info(),
        "timestamp": datetime.now().isoformat(),
    }

    path = output_path or (APP_PATH / "app_info.json")
    path.write_text(json.dumps(info, indent=2, ensure_ascii=False), encoding="utf-8")
    print(f"\n[Export] Info saved to: {path}")


# ///////////////////////////////////////////////////////////////
# MAIN
# ///////////////////////////////////////////////////////////////


def main() -> None:
    """Application entry point."""
    print_header()
    print_system_info()
    print_paths()

    # Export info if --export flag is passed
    if "--export" in sys.argv:
        export_info()

    print("\nApplication finished successfully.")


if __name__ == "__main__":
    main()
