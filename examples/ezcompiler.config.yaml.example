# ///////////////////////////////////////////////////////////////
# EXAMPLE YAML CONFIG - Cx_Freeze, console app, disk upload
# ///////////////////////////////////////////////////////////////
# Scenario: Application console compilée avec Cx_Freeze
# - Console visible (CLI tool)
# - Upload sur disque local
# - Debug activé, pas de zip

version: "1.0.0"
project_name: "ExampleApp-CxFreeze"
project_description: "Sample console application compiled with Cx_Freeze"
company_name: "EzCompiler Inc."
author: "Dev Team"
main_file: "main.py"
output_folder: "dist/cxfreeze_build"
icon: ""
version_filename: "version_info.txt"
include_files:
  files:
    - "main.py"
  folders: []
packages:
  - json
  - os
  - platform
includes:
  - datetime
excludes:
  - tkinter
  - unittest
  - email
  - xml

compilation:
  compiler: "Cx_Freeze"
  console: true
  repo_needed: true

upload:
  repo_destination: "disk"
  release_destination: "disk"
  repo_path: "releases/CxFreeze"
  server_url: ""

advanced:
  optimize: false
  strip: false
  debug: true

release:
  release_needed: true
  release_type: "tufup"
  tufup_repo_dir: "tuf_repository"
  tufup_keys_dir: "tuf_keys"
  # Destination de l'upload du dossier release plat (metadata + targets + zip, sans sous-dossiers).
  # Si vide, fallback sur upload.repo_path (disk) ou upload.server_url (server).
  update_repo_url: null
