# ///////////////////////////////////////////////////////////////
# EXAMPLE YAML CONFIG - Cx_Freeze, console app, disk upload
# ///////////////////////////////////////////////////////////////
# Scenario: Application console compilée avec Cx_Freeze
# - Console visible (CLI tool)
# - Upload sur disque local

version: "1.0.0"
project_name: "ExampleApp-CxFreeze"
project_description: "Sample console application compiled with Cx_Freeze"
company_name: "EzCompiler Inc."
author: "Dev Team"
main_file: "main.py"
output_folder: "dist/cxfreeze_build"
icon: ""
version_filename: "version_info.txt"
include_files:
  files:
    - "main.py"
  folders: []
packages:
  - json
  - os
  - platform
includes:
  - datetime
excludes:
  - tkinter
  - unittest
  - email
  - xml

compilation:
  compiler: "Cx_Freeze"
  console: true

# Compiler-specific options: only the section matching 'compiler' is used.
cx_freeze:
  optimize: false
  strip: false

upload:
  repo_destination: "disk"
  repo_endpoint: "releases/CxFreeze"
  release_destination: "disk"
  release_endpoint: ""

advanced:
  debug: true

release:
  tuf_enabled: true
  tuf_repo_dir: "tuf/repository"
  tuf_keys_dir: "tuf/keystore"
  # repo_endpoint (upload section) indique où uploader l'arbre TUF.

installer:
  installer_enabled: true
  installer_output_dir: "dist/installer"
  # installer_iss_path non défini : le template .iss embarqué d'ezcompiler
  # est utilisé. Nécessite ISCC.exe (Inno Setup 6) détectable dans le PATH.
