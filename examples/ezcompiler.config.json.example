{
  "version": "1.0.0",
  "project_name": "ExampleApp-Nuitka",
  "project_description": "Sample application compiled with Nuitka",
  "company_name": "EzCompiler Inc.",
  "author": "Dev Team",
  "main_file": "main.py",
  "output_folder": "dist/nuitka_build",
  "icon": "",
  "version_filename": "version_info.txt",
  "include_files": {
    "files": [
      "main.py"
    ],
    "folders": []
  },
  "packages": [
    "json",
    "os",
    "platform",
    "sys"
  ],
  "includes": [
    "datetime",
    "pathlib"
  ],
  "excludes": [
    "tkinter",
    "unittest",
    "test",
    "email",
    "xml",
    "http"
  ],
  "advanced": {
    "debug": false
  },
  "compilation": {
    "compiler": "Nuitka",
    "console": true
  },
  "nuitka": {
    "optimize": true,
    "strip": true
  },
  "upload": {
    "repo_destination": "disk",
    "repo_endpoint": "releases/Nuitka",
    "release_destination": "disk",
    "release_endpoint": ""
  },
  "release": {
    "tuf_enabled": true,
    "tuf_repo_dir": "tuf/repository",
    "tuf_keys_dir": "tuf/keystore"
  },
  "installer": {
    "installer_enabled": true,
    "installer_output_dir": "dist/installer"
  }
}
