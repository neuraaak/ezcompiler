# ///////////////////////////////////////////////////////////////
# SETUP_EXAMPLE - Example setup script for EzCompiler
# Project: ezcompiler
# ///////////////////////////////////////////////////////////////

"""
Setup example - Sample compilation setup script for EzCompiler.

Supports two modes:
  - Config file mode  : pass --config <path> to load a JSON/YAML/TOML config.
  - Inline mode       : no --config arg, uses hardcoded init_project() call below.

One-time key setup (run before the first build with release_needed = True):
    python setup.py --init
    # or via the CLI: ezcompiler release init

The TUF release step runs automatically when release_needed = True in config.
Pass --skip-release to bypass it for a given build.

Usage:
    python setup.py                            # inline config
    python setup.py --config ezcompiler.config.json
    python setup.py --init                     # first-time TUF key setup
    python setup.py --skip-release             # build without release stage
"""

from __future__ import annotations

# ///////////////////////////////////////////////////////////////
# IMPORTS
# ///////////////////////////////////////////////////////////////
# Standard library imports
import argparse
import locale
import sys
from datetime import datetime
from pathlib import Path

# Third-party imports
from ezcompiler import EzCompiler
from ezcompiler.services import ConfigService
from ezplog import Ezpl

# ///////////////////////////////////////////////////////////////
# CONSTANTS
# ///////////////////////////////////////////////////////////////

__VERSION__ = "1.0.0"
__ZIP_NEEDED__ = True
__REPO_NEEDED__ = True

APP_PATH = (
    Path(sys._MEIPASS) # type: ignore
    if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS")
    else Path(sys.argv[0]).parent
)
REPO_PATH = "releases/CxFreeze"

# ///////////////////////////////////////////////////////////////
# VARIABLES
# ///////////////////////////////////////////////////////////////

# ------------------------------------------------
# PROJECT METADATA
# ------------------------------------------------

version = __VERSION__
project_name = "ExampleApp-CxFreeze"
project_description = "Sample console application compiled with Cx_Freeze"
company_name = "EzCompiler Inc."
author = "Dev Team"
icon = ""

# ------------------------------------------------
# PATHS AND FILES
# ------------------------------------------------

main_file = "main.py"
version_file = "version_info.txt"
output_folder = APP_PATH / "dist/cxfreeze_build"

# ------------------------------------------------
# COMPILATION SETTINGS
# ------------------------------------------------

include_files = {"files": ["main.py"], "folders": []}
packages = ["json", "os", "platform"]
includes = ["datetime"]
excludes = ["tkinter", "unittest", "email", "xml"]

# ------------------------------------------------
# DATE AND COPYRIGHT
# ------------------------------------------------

locale.setlocale(locale.LC_TIME, "fr_FR")
date = datetime.now()
annee = str(date.year)

COPYRIGHT = f"Copyright (c) {annee} {company_name}. Tous droits réservés."

ASCII_SCRIPT_DEBUT = """
┌─────────────────┐
| Début du script |
└─────────────────┘
"""

ASCII_SCRIPT_FIN = """
┌─────────────────┐
| Script terminé  |
└─────────────────┘
"""

# ///////////////////////////////////////////////////////////////
# ARGS
# ///////////////////////////////////////////////////////////////


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="EzCompiler setup script")
    parser.add_argument(
        "--config",
        type=Path,
        default=None,
        metavar="PATH",
        help="Path to a JSON, YAML or TOML config file (skips inline init_project)",
    )
    parser.add_argument(
        "--init",
        action="store_true",
        default=False,
        help="Initialise TUF signing keys (one-time setup, then exit)",
    )
    parser.add_argument(
        "--skip-release",
        dest="skip_release",
        action="store_true",
        default=False,
        help="Skip the release stage even when release_needed is True in config",
    )
    return parser.parse_args()


# ///////////////////////////////////////////////////////////////
# SCRIPT
# ///////////////////////////////////////////////////////////////

print(COPYRIGHT)
print(ASCII_SCRIPT_DEBUT, end="\n")

args = parse_args()
Ezpl().set_level("DEBUG")

compiler = None
try:
    if args.config:
        # ------------------------------------------------
        # CONFIG FILE MODE — load JSON / YAML / TOML
        # ------------------------------------------------
        config = ConfigService.build_compiler_config(config_path=args.config)
        compiler = EzCompiler(config=config)

        if args.init:
            # One-time key setup — exits after completion
            compiler.init_release()
            raise SystemExit(0)

        compiler.run_pipeline(
            console=config.console,
            compiler=config.compiler if config.compiler != "auto" else None,
            skip_zip=not config.zip_needed,
            skip_upload=not config.repo_needed,
            upload_structure=config.upload_structure if config.repo_needed else None,
            upload_destination=config.repo_path if config.repo_needed else None,
            skip_release=args.skip_release,
        )

    else:
        # ------------------------------------------------
        # INLINE MODE — hardcoded project settings
        # ------------------------------------------------
        compiler = EzCompiler()

        compiler.init_project(
            version=version,
            project_name=project_name,
            project_description=project_description,
            company_name=company_name,
            author=author,
            icon=icon,
            main_file=main_file,
            version_filename=version_file,
            output_folder=output_folder,
            include_files=include_files,
            packages=packages,
            includes=includes,
            excludes=excludes,
        )

        if args.init:
            compiler.init_release()
            raise SystemExit(0)

        compiler.run_pipeline(
            console=True,
            compiler=None,
            skip_zip=not __ZIP_NEEDED__,
            skip_upload=not __REPO_NEEDED__,
            upload_structure="disk" if __REPO_NEEDED__ else None,
            upload_destination=REPO_PATH if __REPO_NEEDED__ else None,
            skip_release=args.skip_release,
        )

except Exception as e:
    if compiler is not None:
        compiler.printer.error(e)
        compiler.logger.error(e)
    else:
        print(f"ERROR :: {e}", file=sys.stderr)
    raise SystemExit(1) from e

# ///////////////////////////////////////////////////////////////
# END
# ///////////////////////////////////////////////////////////////

print(ASCII_SCRIPT_FIN)
