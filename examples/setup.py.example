# ///////////////////////////////////////////////////////////////
# SETUP_EXAMPLE - Example setup script for EzCompiler
# Project: ezcompiler
# ///////////////////////////////////////////////////////////////

"""
Setup example - Sample compilation setup script for EzCompiler.

This script demonstrates how to use EzCompiler programmatically
via init_project() to compile, zip, and upload a Python project.
"""

from __future__ import annotations

# ///////////////////////////////////////////////////////////////
# IMPORTS
# ///////////////////////////////////////////////////////////////
# Standard library imports
import locale
import sys
from datetime import datetime
from pathlib import Path

# Third-party imports
from ezcompiler import EzCompiler

# ///////////////////////////////////////////////////////////////
# CONSTANTS
# ///////////////////////////////////////////////////////////////

__VERSION__ = "1.0.0"
__ZIP_NEEDED__ = True
__REPO_NEEDED__ = True

APP_PATH = (
    Path(sys._MEIPASS)
    if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS")
    else Path(sys.argv[0]).parent
)
REPO_PATH = "releases/CxFreeze"

# ///////////////////////////////////////////////////////////////
# VARIABLES
# ///////////////////////////////////////////////////////////////

# ------------------------------------------------
# PROJECT METADATA
# ------------------------------------------------

version = __VERSION__
project_name = "ExampleApp-CxFreeze"
project_description = "Sample console application compiled with Cx_Freeze"
company_name = "EzCompiler Inc."
author = "Dev Team"
icon = ""

# ------------------------------------------------
# PATHS AND FILES
# ------------------------------------------------

main_file = "main.py"
version_file = "version_info.txt"
output_folder = APP_PATH / "dist/cxfreeze_build"

# ------------------------------------------------
# COMPILATION SETTINGS
# ------------------------------------------------

include_files = {"files": ["main.py"], "folders": []}
packages = ["json", "os", "platform"]
includes = ["datetime"]
excludes = ["tkinter", "unittest", "email", "xml"]

# ------------------------------------------------
# DATE AND COPYRIGHT
# ------------------------------------------------

locale.setlocale(locale.LC_TIME, "fr_FR")
date = datetime.now()
annee = str(date.year)

COPYRIGHT = f"Copyright (c) {annee} {company_name}. Tous droits réservés."

ASCII_SCRIPT_DEBUT = """
┌─────────────────┐
| Début du script |
└─────────────────┘
"""

ASCII_SCRIPT_FIN = """
┌─────────────────┐
| Script terminé  |
└─────────────────┘
"""

# ///////////////////////////////////////////////////////////////
# SCRIPT
# ///////////////////////////////////////////////////////////////

print(COPYRIGHT)
print(ASCII_SCRIPT_DEBUT, end="\n")

compiler = EzCompiler()
compiler._ezpl.add_separator()

try:
    ## => INIT PROJECT
    compiler.init_project(
        version=version,
        project_name=project_name,
        project_description=project_description,
        company_name=company_name,
        author=author,
        icon=icon,
        main_file=main_file,
        version_filename=version_file,
        output_folder=output_folder,
        include_files=include_files,
        packages=packages,
        includes=includes,
        excludes=excludes,
    )

    ## => RUN BUILD PIPELINE (version, compile, zip, upload with DLP)
    compiler.run_pipeline(
        console=True,
        compiler=None,
        skip_zip=not __ZIP_NEEDED__,
        skip_upload=not __REPO_NEEDED__,
        upload_structure="disk" if __REPO_NEEDED__ else None,
        upload_destination=REPO_PATH if __REPO_NEEDED__ else None,
    )

except Exception as e:
    compiler.printer.error(e)
    compiler.logger.error(e)
    raise SystemExit(1) from e

# ///////////////////////////////////////////////////////////////
# END
# ///////////////////////////////////////////////////////////////

print(ASCII_SCRIPT_FIN)
