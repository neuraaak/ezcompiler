# ///////////////////////////////////////////////////////////////
# EXAMPLE PYPROJECT.TOML - PyInstaller, no-console (GUI app)
# ///////////////////////////////////////////////////////////////
# Scenario: Application GUI compilée avec PyInstaller
# - Pas de console (fenêtre cachée)
# - Upload sur serveur distant
# - Mode optimisé, strip activé

[project]
name = "ExampleApp-PyInstaller"
version = "1.0.0"
description = "Sample GUI application compiled with PyInstaller"
authors = [{ name = "Dev Team" }]

[tool.ezcompiler]
main_file = "main.py"
output_folder = "dist/pyinstaller_build"
icon = ""
include_files = { files = [], folders = [] }
packages = ["json", "pathlib"]
includes = []
excludes = ["tkinter", "unittest", "test"]

[tool.ezcompiler.compilation]
compiler = "PyInstaller"
console = true

[tool.ezcompiler.upload]
repo_destination = "disk"
repo_endpoint = "releases/PyInstaller"
release_destination = "disk"
release_endpoint = ""

[tool.ezcompiler.advanced]
optimize = true
strip = true
debug = false

[tool.ezcompiler.release]
tuf_enabled = true
tuf_repo_dir = "tuf/repository"
tuf_keys_dir = "tuf/keystore"
# repo_endpoint (section upload) indique où uploader l'arbre TUF.
