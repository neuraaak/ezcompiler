; Generated by ezcompiler — Inno Setup script
; Editable: rerun `ezcompiler generate iss --force` to regenerate from config.

<% if standalone %>
; Volatile values, overridden by ezcompiler via ISCC /D at build time.
#ifndef MyAppVersion
  #define MyAppVersion "0.0.0-dev"
#endif
#ifndef VersionInfo
  #define VersionInfo "0.0.0.0"
#endif
#ifndef BundleDir
  #define BundleDir "..\dist"
#endif
#ifndef OutputDir
  #define OutputDir "."
#endif
#ifndef MainExe
  #define MainExe "<< project_name | iss >>.exe"
#endif
<% endif %>
#define MyAppName "<< project_name | iss >>"
#define MyAppPublisher "<< company_name | iss >>"

[Setup]
AppId={<< app_id >>
AppName={#MyAppName}
AppVersion={#MyAppVersion}
VersionInfoVersion={#VersionInfo}
AppPublisher={#MyAppPublisher}
<% if config.publisher_url %>
AppPublisherURL=<< config.publisher_url | iss >>
<% endif %>
<% if config.support_url %>
AppSupportURL=<< config.support_url | iss >>
<% endif %>
<% if config.updates_url %>
AppUpdatesURL=<< config.updates_url | iss >>
<% endif %>
<% if config.architecture != "auto" %>
ArchitecturesAllowed=<< config.architecture >>
ArchitecturesInstallIn64BitMode=<< config.architecture >>
<% endif %>
<% if config.per_user %>
DefaultDirName={localappdata}\Programs\{#MyAppName}
PrivilegesRequired=lowest
<% else %>
DefaultDirName={autopf}\{#MyAppName}
PrivilegesRequired=admin
<% endif %>
DefaultGroupName=<< (config.start_menu_group or project_name) | iss >>
<% if config.license_file %>
LicenseFile=<< config.license_file | string | iss >>
<% endif %>
OutputDir={#OutputDir}
OutputBaseFilename=<< project_name >>-{#MyAppVersion}-setup
Compression=<< config.compression | iss >>
SolidCompression=yes
WizardStyle=<< config.wizard_style >>
<% if config.close_running_app %>
CloseApplications=force
RestartApplications=yes
<% endif %>
<% if icon %>
SetupIconFile=<< icon | iss >>
<% endif %>
<% if config.sign_tool_name %>
SignTool=<< config.sign_tool_name | iss >>
<% endif %>
<% for key, value in config.extra_setup_directives.items() %>
<< key >>=<< value >>
<% endfor %>

[Languages]
<% for lang in config.languages %>
<% if lang == "english" %>
Name: "<< lang >>"; MessagesFile: "compiler:Default.isl"
<% else %>
Name: "<< lang >>"; MessagesFile: "compiler:Languages\<< lang | capitalize >>.isl"
<% endif %>
<% endfor %>

[Tasks]
<% if config.desktop_icon %>
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
<% endif %>

[Files]
Source: "{#BundleDir}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MainExe}"
<% if config.desktop_icon %>
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MainExe}"; Tasks: desktopicon
<% endif %>
<% if config.launch_after_install %>

[Run]
Filename: "{app}\{#MainExe}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
<% endif %>
<% if config.add_to_path %>

[Registry]
Root: HKCU; Subkey: "Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};{app}"; Flags: preservestringtype; Check: NeedsAddPath(ExpandConstant('{app}'))
<% endif %>
<% if config.uninstall_delete %>

[UninstallDelete]
<% for entry in config.uninstall_delete %>
Type: filesandordirs; Name: "<< entry >>"
<% endfor %>
<% endif %>
<% for section_name, section_lines in config.extra_sections.items() %>
<% if section_name != "Code" %>

[<< section_name >>]
<% for line in section_lines %>
<< line >>
<% endfor %>
<% endif %>
<% endfor %>
<%- set user_code = config.extra_sections.get("Code", []) %>
<% if config.add_to_path or user_code %>

[Code]
<% if config.add_to_path %>
// Anti-duplicate guard for the [Registry] Path entry: without it every
// reinstall re-appends the app directory and Environment\Path truncates.
function NeedsAddPath(Param: string): Boolean;
var
  OrigPath: string;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', OrigPath) then
  begin
    Result := True;
    exit;
  end;
  Result := Pos(';' + Uppercase(Param) + ';', ';' + Uppercase(OrigPath) + ';') = 0;
end;

// Surgical removal of our own entry at uninstall. Never done with
// uninsdeletevalue on the [Registry] entry: that flag deletes the whole
// Path value, taking every other program's entry with it.
procedure RemoveFromPath(Param: string);
var
  OrigPath: string;
  Position: Integer;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', OrigPath) then
    exit;
  Position := Pos(';' + Uppercase(Param) + ';', ';' + Uppercase(OrigPath) + ';');
  if Position = 0 then
    exit;
  if Position = 1 then
    Delete(OrigPath, 1, Length(Param) + 1)
  else
    Delete(OrigPath, Position - 1, Length(Param) + 1);
  RegWriteExpandStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', OrigPath);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
    RemoveFromPath(ExpandConstant('{app}'));
end;
<% endif %>
<% for line in user_code %>
<< line >>
<% endfor %>
<% endif %>
