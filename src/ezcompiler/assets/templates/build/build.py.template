# ///////////////////////////////////////////////////////////////
# BUILD - Compilation build script
# Project: #PROJECT_NAME_RAW#
# ///////////////////////////////////////////////////////////////

"""
Build script for #PROJECT_NAME_RAW#.

Drives EzCompiler through the build pipeline: version file, compilation,
optional ZIP archive, optional Windows installer, optional TUF release.
Publication is a separate, explicit CLI step: see `ezcompiler publish`.
"""

from __future__ import annotations

# ///////////////////////////////////////////////////////////////
# IMPORTS
# ///////////////////////////////////////////////////////////////
# Standard library imports
import sys
from datetime import datetime
from pathlib import Path

# Third-party imports
from ezcompiler import EzCompiler
from ezplog import Ezpl

# ///////////////////////////////////////////////////////////////
# CONSTANTS
# ///////////////////////////////////////////////////////////////

__VERSION__ = #VERSION#
__ZIP_NEEDED__ = #ZIP_NEEDED#

APP_PATH = (
    Path(sys._MEIPASS)
    if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS")
    else Path(sys.argv[0]).parent
)

# ///////////////////////////////////////////////////////////////
# VARIABLES
# ///////////////////////////////////////////////////////////////

# ------------------------------------------------
# PROJECT METADATA
# ------------------------------------------------

version = __VERSION__
project_name = #PROJECT_NAME#
project_description = #PROJECT_DESCRIPTION#
company_name = #COMPANY_NAME#
author = #AUTHOR#
icon = #ICON#

# ------------------------------------------------
# PATHS AND FILES
# ------------------------------------------------

main_file = #MAIN_FILE#
version_file = #VERSION_FILE#
output_folder = APP_PATH / #OUTPUT_FOLDER#

# ------------------------------------------------
# COMPILATION SETTINGS
# ------------------------------------------------

include_files = #INCLUDE_FILES#
packages = #PACKAGES#
includes = #INCLUDES#
excludes = #EXCLUDES#

# ------------------------------------------------
# COPYRIGHT
# ------------------------------------------------

COPYRIGHT = f"Copyright (c) {datetime.now().year} {company_name}. All rights reserved."

# ///////////////////////////////////////////////////////////////
# SCRIPT
# ///////////////////////////////////////////////////////////////

print(COPYRIGHT)

# EzCompiler stays silent until the host application initializes Ezpl:
# printer and logger are passive proxies, and run_pipeline() needs a live
# progress display.
Ezpl()

compiler = EzCompiler()

try:
    ## => INIT PROJECT
    compiler.init_project(
        version=version,
        project_name=project_name,
        project_description=project_description,
        company_name=company_name,
        author=author,
        icon=icon,
        main_file=main_file,
        version_filename=version_file,
        output_folder=output_folder,
        include_files=include_files,
        packages=packages,
        includes=includes,
        excludes=excludes,
    )

    ## => RUN BUILD PIPELINE (version, compile, zip, installer, release)
    ## The installer stage runs when installer.enabled is true in the
    ## configuration; pass skip_installer=True to bypass it for one run.
    ## Pass skip_build=True to resume from an existing build in output_folder.
    compiler.run_pipeline(
        console=#CONSOLE#,
        compiler=#COMPILER#,
        skip_zip=not __ZIP_NEEDED__,
    )

    ## => PUBLICATION
    ## La publication est un acte délibéré, hors de ce script. Les deux
    ## commandes demandent confirmation avant d'agir :
    ##     ezcompiler publish update     # arbre de mise à jour TUF
    ##     ezcompiler publish release    # installeur + zip
    compiler.printer.info("Build terminé. Pour publier :")
    compiler.printer.info("  ezcompiler publish update")
    compiler.printer.info("  ezcompiler publish release")

except Exception as e:
    compiler.printer.error(e)
    compiler.logger.error(e)
    raise SystemExit(1) from e
