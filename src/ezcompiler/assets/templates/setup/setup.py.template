# ///////////////////////////////////////////////////////////////
# SETUP - Compilation setup script
# Project: #PROJECT_NAME#
# ///////////////////////////////////////////////////////////////

"""
Setup script for #PROJECT_NAME# compilation.

This script uses EzCompiler to compile, zip, and upload the project.
"""

from __future__ import annotations

# ///////////////////////////////////////////////////////////////
# IMPORTS
# ///////////////////////////////////////////////////////////////
# Standard library imports
import locale
import sys
from datetime import datetime
from pathlib import Path

# Third-party imports
from ezcompiler import EzCompiler

# ///////////////////////////////////////////////////////////////
# CONSTANTS
# ///////////////////////////////////////////////////////////////

__VERSION__ = "#VERSION#"
__ZIP_NEEDED__ = #ZIP_NEEDED#
__REPO_NEEDED__ = #REPO_NEEDED#

APP_PATH = (
    Path(sys._MEIPASS)
    if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS")
    else Path(sys.argv[0]).parent
)
REPO_PATH = "#REPO_PATH#"

# ///////////////////////////////////////////////////////////////
# VARIABLES
# ///////////////////////////////////////////////////////////////

# ------------------------------------------------
# PROJECT METADATA
# ------------------------------------------------

version = __VERSION__
project_name = "#PROJECT_NAME#"
project_description = "#PROJECT_DESCRIPTION#"
company_name = "#COMPANY_NAME#"
author = "#AUTHOR#"
icon = "#ICON#"

# ------------------------------------------------
# PATHS AND FILES
# ------------------------------------------------

main_file = "#MAIN_FILE#"
config_file = APP_PATH / f"{project_name}_config.exemple.yaml"
version_file = "#VERSION_FILE#"
output_folder = APP_PATH / "#OUTPUT_FOLDER#"

# ------------------------------------------------
# COMPILATION SETTINGS
# ------------------------------------------------

include_files = #INCLUDE_FILES#
packages = #PACKAGES#
includes = #INCLUDES#
excludes = #EXCLUDES#

# ------------------------------------------------
# DATE AND COPYRIGHT
# ------------------------------------------------

locale.setlocale(locale.LC_TIME, "fr_FR")
date = datetime.now()
annee = str(date.year)

COPYRIGHT = f"Copyright (c) {annee} {company_name}. Tous droits réservés."

ASCII_SCRIPT_DEBUT = """
┌─────────────────┐
| Début du script |
└─────────────────┘
"""

ASCII_SCRIPT_FIN = """
┌─────────────────┐
| Script terminé  |
└─────────────────┘
"""

# ///////////////////////////////////////////////////////////////
# SCRIPT
# ///////////////////////////////////////////////////////////////

print(COPYRIGHT)
print(ASCII_SCRIPT_DEBUT, end="\n")

compiler = EzCompiler()
compiler._ezpl.add_separator()

try:
    ## => INIT PROJECT
    compiler.init_project(
        version=version,
        project_name=project_name,
        project_description=project_description,
        company_name=company_name,
        author=author,
        icon=icon,
        main_file=main_file,
        version_filename=version_file,
        output_folder=output_folder,
        include_files=include_files,
        packages=packages,
        includes=includes,
        excludes=excludes,
    )

    ## => RUN BUILD PIPELINE (version, compile, zip, upload with DLP)
    compiler.run_pipeline(
        console=#CONSOLE#,
        compiler=None,
        skip_zip=not __ZIP_NEEDED__,
        skip_upload=not __REPO_NEEDED__,
        upload_structure="#UPLOAD_STRUCTURE#" if __REPO_NEEDED__ else None,
        upload_destination=REPO_PATH if __REPO_NEEDED__ else None,
    )

except Exception as e:
    compiler.printer.error(e)
    compiler.logger.error(e)
    raise SystemExit(1) from e

# ///////////////////////////////////////////////////////////////
# END
# ///////////////////////////////////////////////////////////////

print(ASCII_SCRIPT_FIN)
