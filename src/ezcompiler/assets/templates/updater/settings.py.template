from __future__ import annotations

import os
import sys
from pathlib import Path

APP_NAME = "#APP_NAME#"
VERSION = "#VERSION#"
UPDATE_URL = "#UPDATE_URL#"

# Directory the app is actually installed in — wherever the user put it.
# For a frozen bundle (PyInstaller, cx_Freeze, Nuitka), sys.executable is
# the real .exe path, so its parent is the install folder. This is what
# tufup replaces on update, so it must track the executable, not a fixed
# %LOCALAPPDATA% location. In dev (not frozen), fall back to this file's dir.
if getattr(sys, "frozen", False):
    INSTALL_DIR = Path(sys.executable).parent
else:
    INSTALL_DIR = Path(__file__).parent

# TUF metadata/target cache — deliberately separate from INSTALL_DIR. When
# the app is installed in a location requiring elevation (e.g. Program
# Files), INSTALL_DIR is not writable by the running (non-elevated) process,
# so the TUF client cache (metadata/targets, rewritten on every check) must
# live in a always-user-writable directory instead.
_CACHE_ROOT = Path(
    os.environ.get("LOCALAPPDATA")
    or os.environ.get("XDG_CACHE_HOME")
    or Path.home() / ".cache"
)
CACHE_DIR = _CACHE_ROOT / APP_NAME / "tuf"
