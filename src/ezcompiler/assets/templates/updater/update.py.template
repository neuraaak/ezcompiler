from __future__ import annotations

import sys
from pathlib import Path

from tufup.client import Client

from settings import APP_NAME, INSTALL_DIR, UPDATE_URL, VERSION

# ---------------------------------------------------------------------------
# Root certificate path — bundler-agnostic
# PyInstaller extracts data files to sys._MEIPASS; cx_Freeze and Nuitka
# place them alongside sys.executable.
# ---------------------------------------------------------------------------
if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS"):
    _base = Path(sys._MEIPASS)
else:
    _base = Path(sys.executable).parent

ROOT_JSON = _base / "root.json"


def check_for_updates(*, pre: str | None = None) -> bool:
    """Check for a newer version and apply it if available.

    Args:
        pre: Pre-release tag to include (e.g. "a", "b", "rc"). None = stable only.

    Returns:
        True if an update was downloaded and applied; False otherwise.
    """
    client = Client(
        app_name=APP_NAME,
        app_install_dir=INSTALL_DIR,
        current_version=VERSION,
        highest_version=None,
        metadata_base_url=f"{UPDATE_URL}/metadata/",
        target_base_url=f"{UPDATE_URL}/targets/",
        trusted_root_path=ROOT_JSON,
    )
    new_version = client.check_for_updates(pre=pre)
    if new_version is None:
        return False
    client.download_and_apply_update(skip_confirmation=False)
    return True


def main() -> None:
    """Entry point for startup update check.

    Call this at the very top of main.py:

        import update
        update.main()
    """
    if check_for_updates():
        # tufup's .bat script (robocopy) relaunches the app automatically.
        sys.exit(0)


if __name__ == "__main__":
    main()
