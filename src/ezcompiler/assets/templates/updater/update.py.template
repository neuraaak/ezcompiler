from __future__ import annotations

import shutil
import sys
from collections.abc import Iterator
from pathlib import Path
from urllib.parse import urlparse
from urllib.request import url2pathname

from tuf.api.exceptions import DownloadHTTPError
from tuf.ngclient import FetcherInterface
from tufup.client import Client

from settings import APP_NAME, INSTALL_DIR, UPDATE_URL, VERSION

_CHUNK_SIZE = 64 * 1024


class _FileFetcher(FetcherInterface):
    """Serve ``file://`` URLs for the TUF client.

    tufup's default (requests-based) fetcher cannot read ``file://`` and,
    worse, fails the root-rotation probe instead of treating a missing
    ``N.root.json`` as "no newer root". This fetcher raises a 404 for
    missing files so tuf stops the probe cleanly, making disk-served
    repositories usable client-side.
    """

    def _fetch(self, url: str) -> Iterator[bytes]:
        path = Path(url2pathname(urlparse(url).path))
        if not path.is_file():
            raise DownloadHTTPError(f"File not found: {path}", 404)
        with path.open("rb") as handle:
            while chunk := handle.read(_CHUNK_SIZE):
                yield chunk

# ---------------------------------------------------------------------------
# Bundled root.json — bundler-agnostic resolution.
# PyInstaller extracts data files to sys._MEIPASS; cx_Freeze and Nuitka
# place them alongside this module / the executable. In dev, it sits next
# to this file.
# ---------------------------------------------------------------------------
if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS"):
    _BUNDLED_ROOT = Path(sys._MEIPASS) / "root.json"  # type: ignore[attr-defined]
else:
    _BUNDLED_ROOT = Path(__file__).parent / "root.json"

# Writable local caches required by tufup 0.10. tuf.ngclient loads the
# trusted root from METADATA_DIR automatically, so the bundled root.json
# is copied there on first run.
METADATA_DIR = INSTALL_DIR / "metadata"
TARGET_DIR = INSTALL_DIR / "targets"


def _bootstrap_trust_root() -> None:
    """Install the bundled trust root into the metadata cache.

    The bundled ``root.json`` is the trust anchor shipped with THIS build.
    If the cache holds a different root — because the repo keystore was
    regenerated (not a valid TUF rotation) or a stale dev keystore lingers —
    a cached root signed by old keys can never validate the new metadata and
    tuf fails with "signed by 0/1 keys". So when the cached root differs from
    the bundled one, the metadata cache is reset and re-seeded with the
    bundled root; tuf then refreshes forward from it.
    """
    cached_root = METADATA_DIR / "root.json"
    if (
        cached_root.exists()
        and cached_root.read_bytes() == _BUNDLED_ROOT.read_bytes()
    ):
        return
    if METADATA_DIR.exists():
        shutil.rmtree(METADATA_DIR)
    METADATA_DIR.mkdir(parents=True, exist_ok=True)
    shutil.copy(_BUNDLED_ROOT, cached_root)


def _make_client() -> Client:
    """Build a tufup Client, bootstrapping the trusted root on first run."""
    _bootstrap_trust_root()
    TARGET_DIR.mkdir(parents=True, exist_ok=True)

    client = Client(
        app_name=APP_NAME,
        app_install_dir=INSTALL_DIR,
        current_version=VERSION,
        metadata_dir=METADATA_DIR,
        metadata_base_url=f"{UPDATE_URL}/metadata/",
        target_dir=TARGET_DIR,
        target_base_url=f"{UPDATE_URL}/targets/",
    )
    # tufup hardcodes a requests-based fetcher that cannot read file://.
    # Swap it for a file fetcher when serving from disk.
    if UPDATE_URL.startswith("file://"):
        client._fetcher = _FileFetcher()
    return client


def _refresh_and_check(client: Client, pre: str | None):
    """Refresh TUF metadata, then check for a newer target.

    tufup's check_for_updates() swallows refresh failures (repo unreachable
    or incomplete) and returns None — indistinguishable from "no update", so
    a broken repo would be reported as "up to date". Refreshing explicitly
    first makes a failed refresh raise instead, so callers can tell a real
    "up to date" from a failed check. The subsequent check_for_updates()
    refreshes again (cheap: metadata is already cached).
    """
    client.refresh()
    return client.check_for_updates(pre=pre)


def get_latest_version(*, pre: str | None = None) -> str | None:
    """Return the highest available version newer than the current one.

    Args:
        pre: Pre-release tag to include (e.g. "a", "b", "rc"). None = stable.

    Returns:
        The new version string if an update is available, else None.

    Raises:
        Exception: If the TUF refresh fails (network/signature error). This
            is deliberate — a failed check must not look like "up to date".
    """
    new_target = _refresh_and_check(_make_client(), pre)
    return None if new_target is None else str(new_target.version)


def report_latest(*, pre: str | None = None) -> None:
    """Print the latest available version. Never raises — safe at startup."""
    try:
        latest = get_latest_version(pre=pre)
    except Exception as exc:  # noqa: BLE001 - never block app startup
        print(f"[update] check failed: {exc}")
        return
    if latest is None:
        print(f"[update] up to date (current version: {VERSION})")
    else:
        print(f"[update] new version available: {latest} (current: {VERSION})")


def check_and_apply(
    *, pre: str | None = None, skip_confirmation: bool = False
) -> bool:
    """Check for a newer version, print it, and apply it if available.

    Args:
        pre: Pre-release tag to include (e.g. "a", "b", "rc"). None = stable.
        skip_confirmation: If True, apply without the interactive prompt.
            Console apps can keep the prompt; windowed (GUI) apps with no
            console should pass True (or drive their own confirmation UI).

    Returns:
        True if an update was downloaded and applied; False otherwise.
    """
    client = _make_client()
    new_target = _refresh_and_check(client, pre)
    if new_target is None:
        print(f"[update] up to date (current version: {VERSION})")
        return False
    print(f"[update] new version available: {new_target.version} (current: {VERSION})")
    client.download_and_apply_update(skip_confirmation=skip_confirmation)
    return True


def main(*, skip_confirmation: bool = False) -> None:
    """Startup hook — check for an update and apply it if available.

    Call this at the very top of your app's main.py:

        import update
        update.main()

    On success, tufup writes a script (robocopy on Windows) that replaces
    the installed files and relaunches the app, so the process exits here.
    Never blocks startup: a failed check is reported and ignored.
    """
    try:
        applied = check_and_apply(skip_confirmation=skip_confirmation)
    except Exception as exc:  # noqa: BLE001 - never block app startup
        print(f"[update] check failed: {exc}")
        return
    if applied:
        print("[update] update applied — restarting...")
        sys.exit(0)


if __name__ == "__main__":
    main()
